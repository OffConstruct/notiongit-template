{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "lattice",
  "name": "Lattice",
  "version": "1.0.0",
  "summary": "The lab front door: an identity sheet of academic links, then numbered sections on a ruled grid.",
  "description": "Atkinson Hyperlegible on a 12-column grid. The home opens with an identity sheet (role, research statement, identifiers, photo), then numbered sections: Selected, Writing as a ruled table, an index of your pages with their descriptions, and About. For professors, lab leads and students.",
  "categories": ["researchers", "educators"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "atkinson",
      "label": "Atkinson Hyperlegible",
      "google": "family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,600;1,400&family=Atkinson+Hyperlegible+Mono:wght@400;500",
      "stacks": {
        "body": "\"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Atkinson Hyperlegible Next\", \"Atkinson Hyperlegible\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"Atkinson Hyperlegible Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#12161c", "muted": "#4f5967" },
    "dark": { "bg": "#0d1015", "text": "#e6eaf0", "muted": "#9aa4b2" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Institution color", "role": "text", "default": "blue", "custom": true,
      "presets": [
        { "value": "blue", "label": "Institutional blue", "light": "#1f4fa3", "dark": "#8fb0f0" },
        { "value": "crimson", "label": "Crimson", "light": "#a3172e", "dark": "#f0919d" },
        { "value": "teal", "label": "Teal", "light": "#0f6b6b", "dark": "#6cc5bd" },
        { "value": "graphite", "label": "Graphite", "light": "#3a3f47", "dark": "#c3c9d2" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "masthead", "type": "select", "label": "Identity sheet", "default": "photo-right",
      "options": [
        { "value": "photo-right", "label": "Photo right" },
        { "value": "photo-left", "label": "Photo left" },
        { "value": "compact", "label": "Compact, no photo" } ] },
    { "key": "numbers", "type": "boolean", "label": "Number the sections", "default": true },
    { "key": "density", "type": "select", "label": "Density", "default": "comfortable",
      "options": [
        { "value": "comfortable", "label": "Comfortable" },
        { "value": "compact", "label": "Compact" } ] },
    { "key": "list_style", "type": "select", "label": "Writing list", "default": "table",
      "options": [
        { "value": "table", "label": "Ruled table" },
        { "value": "tiles", "label": "Bordered tiles" } ] },
    { "key": "swatch", "type": "boolean", "label": "Accent swatch strip", "default": true }
  ]
}
