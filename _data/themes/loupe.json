{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "loupe",
  "name": "Loupe",
  "version": "1.0.0",
  "summary": "The contact sheet: a tight grid of uncropped frames on a white lightbox, numbered like an edge print.",
  "description": "Your work as a contact sheet. A header bar with your portrait or monogram, a short bio, the featured frames marked in grease-pencil red, then every post as an uncropped frame with its number and month in mono. Readers can filter by tag and switch to a dated list. For working photographers and photo journals.",
  "categories": ["photographers", "designers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "chivo",
      "label": "Chivo and Chivo Mono",
      "google": "family=Chivo:ital,wght@0,400;0,600;1,400&family=Chivo+Mono:wght@400;500",
      "stacks": {
        "body": "Chivo, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "display": "Chivo, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
        "mono": "\"Chivo Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    },
    {
      "value": "system",
      "label": "System fonts",
      "google": null,
      "stacks": {
        "body": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#111111", "muted": "#6b6b6b" },
    "dark": { "bg": "#161616", "text": "#ececea", "muted": "#9a9a96" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Lightbox" },
        { "value": "dark", "label": "Lightbox at night" } ] },
    { "key": "accent", "type": "color", "label": "Grease pencil", "role": "text", "default": "red", "custom": true,
      "presets": [
        { "value": "red", "label": "Red", "light": "#c8321f", "dark": "#ff6a4d" },
        { "value": "cyan", "label": "Cyan", "light": "#0a7d8c", "dark": "#4cc3d1" },
        { "value": "yellow", "label": "Yellow", "light": "#8a6a00", "dark": "#e8c21c" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "font", "type": "font", "label": "Typeface", "default": "chivo" },
    { "key": "columns", "type": "select", "label": "Frames across on wide screens", "default": "6",
      "options": [
        { "value": "4", "label": "Four" },
        { "value": "6", "label": "Six" },
        { "value": "8", "label": "Eight" } ] },
    { "key": "plate", "type": "select", "label": "Frame treatment", "default": "contain",
      "options": [
        { "value": "contain", "label": "Uncropped on a plate" },
        { "value": "square", "label": "Square crop" },
        { "value": "natural", "label": "Natural heights" } ] },
    { "key": "avatar", "type": "select", "label": "Header mark", "default": "photo",
      "options": [
        { "value": "photo", "label": "Profile picture" },
        { "value": "monogram", "label": "Monogram" },
        { "value": "none", "label": "Name only" } ] },
    { "key": "frame_numbers", "type": "boolean", "label": "Frame numbers", "default": true },
    { "key": "view", "type": "select", "label": "Default view", "default": "grid",
      "options": [
        { "value": "grid", "label": "Contact sheet" },
        { "value": "list", "label": "Dated list" } ] },
    { "key": "filter", "type": "boolean", "label": "Tag filter above the sheet", "default": true }
  ]
}
