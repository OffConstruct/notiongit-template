{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "memo",
  "name": "Memo",
  "version": "1.0.0",
  "summary": "The operator's letter: a two-tone statement, a bio written as a letter, and a year-hung index in Newsreader.",
  "description": "For founders whose work speaks for itself. The home page is a letter: your name and tagline as one quiet sentence, your bio, a Start here line built from featured posts, then every post as a title-only index hung on its year. One serif, one accent, no chrome.",
  "categories": ["entrepreneurs", "writers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "newsreader",
      "label": "Newsreader",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,400",
      "stacks": {
        "body": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#faf8f3", "text": "#1b1a17", "muted": "#6b665c" },
    "dark": { "bg": "#151412", "text": "#ece8df", "muted": "#9d978b" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent", "role": "text", "default": "oxblood", "custom": true,
      "presets": [
        { "value": "oxblood", "label": "Oxblood", "light": "#9a2f1f", "dark": "#e88a6f" },
        { "value": "ink-blue", "label": "Ink blue", "light": "#1f3a8a", "dark": "#9db4f0" },
        { "value": "forest", "label": "Forest", "light": "#2f5d3a", "dark": "#8cc79a" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "statement", "type": "select", "label": "Opening line", "default": "two-tone",
      "options": [
        { "value": "two-tone", "label": "Name, then tagline" },
        { "value": "tagline-first", "label": "Tagline large, name as signature" },
        { "value": "name-large", "label": "Name large, tagline small" } ] },
    { "key": "list_style", "type": "select", "label": "Writing index", "default": "by-year",
      "options": [
        { "value": "by-year", "label": "Grouped by year" },
        { "value": "titles-dates", "label": "Titles with dates" },
        { "value": "titles", "label": "Titles only" } ] },
    { "key": "start_here", "type": "boolean", "label": "Start here line from featured posts", "default": true },
    { "key": "nav_style", "type": "select", "label": "Navigation", "default": "inline",
      "options": [
        { "value": "inline", "label": "Row at the top" },
        { "value": "margin", "label": "Stacked in the right margin" },
        { "value": "footer-only", "label": "Footer only" } ] },
    { "key": "text_size", "type": "range", "label": "Text size", "min": 17, "max": 21, "step": 1, "unit": "px", "default": 19 }
  ]
}
