{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "recital",
  "name": "Recital",
  "version": "1.0.0",
  "summary": "For choirs, ensembles and classical or jazz players: a centered concert program under soft, slow light.",
  "description": "For choirs, chamber groups, classical soloists and jazz players who post their concerts. The home page reads like a printed program: your name centered under soft light that drifts slowly across the top, then your concerts (posts tagged live) with dotted lines to each date, then recordings and news, your bio and your links.",
  "categories": ["musicians"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "garamond",
      "label": "Classic",
      "google": "family=EB+Garamond:ital,wght@0,400;0,500;1,400",
      "stacks": {
        "body": "\"EB Garamond\", Garamond, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "\"EB Garamond\", Garamond, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "cormorant",
      "label": "Classic with elegant headings",
      "google": "family=Cormorant+Garamond:ital,wght@0,500;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400",
      "stacks": {
        "body": "\"EB Garamond\", Garamond, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "\"Cormorant Garamond\", Garamond, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f7f5ef", "text": "#1d1b17", "muted": "#6f6a5f" },
    "dark": { "bg": "#14130f", "text": "#ece7da", "muted": "#9a9384" }
  },
  "motion": {
    "shader": "god-rays",
    "placement": "slot",
    "speed": 0.14,
    "frame": 2600,
    "colors": {
      "colorBack": "--ink-bg",
      "colorBloom": "--ink-bg",
      "colors": ["--motion-tint", "--motion-tint-2"]
    },
    "params": {
      "intensity": "--rec-intensity",
      "density": 0.25,
      "spotty": 0.15,
      "midIntensity": 0.06,
      "midSize": 0.2,
      "bloom": 0,
      "offsetY": -0.75
    }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "gold", "custom": true,
      "presets": [
        { "value": "gold", "label": "Old gold", "light": "#86661f", "dark": "#cfae62" },
        { "value": "claret", "label": "Claret", "light": "#8a2f3b", "dark": "#e09aa2" },
        { "value": "slate", "label": "Slate blue", "light": "#3b5a7a", "dark": "#9cb8d6" },
        { "value": "verdigris", "label": "Verdigris", "light": "#3f6b5c", "dark": "#8fc4b0" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "garamond" },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "light", "type": "select", "label": "Light at the top", "default": "soft",
      "options": [
        { "value": "soft", "label": "Soft" },
        { "value": "bright", "label": "Brighter" } ] },
    { "key": "leaders", "type": "boolean", "label": "Dotted lines between titles and dates", "default": true },
    { "key": "notes", "type": "boolean", "label": "Short description under each entry", "default": true }
  ]
}
