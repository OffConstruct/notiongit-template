{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "almanac",
  "name": "Almanac",
  "version": "1.0.0",
  "summary": "The issue shelf: numbered issues on cream, colored by topic, with a tag bar and one subscribe button.",
  "description": "Your writing as a shelf of issues. A short intro and subscribe button, the latest featured post as a wide numbered slab, then a grid of cards where posts without a cover become solid blocks of ink colored by topic. A tag bar with counts makes series browsable. Set in Manrope, for curators, teachers and series writers.",
  "categories": ["marketing", "educators"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post"],
  "fonts": [
    {
      "value": "manrope",
      "label": "Manrope",
      "google": "family=Manrope:wght@400;500;600;700",
      "stacks": {
        "body": "Manrope, \"Avenir Next\", Avenir, \"Segoe UI\", system-ui, sans-serif",
        "display": "Manrope, \"Avenir Next\", Avenir, \"Segoe UI\", system-ui, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f4efe2", "text": "#211e1b", "muted": "#5c574c" },
    "dark": { "bg": "#1f1f1f", "text": "#ede8dc", "muted": "#a8a294" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "light",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light (cream)" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Button and link color", "role": "text", "default": "blue", "custom": true,
      "presets": [
        { "value": "blue", "label": "Archive blue", "light": "#34529c", "dark": "#9db4f0" },
        { "value": "red", "label": "Brick red", "light": "#a8392d", "dark": "#f0a497" },
        { "value": "green", "label": "Bottle green", "light": "#2f6648", "dark": "#8fd1a8" },
        { "value": "ochre", "label": "Ochre", "light": "#7a5a12", "dark": "#e0b866" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "cta", "type": "select", "label": "Main button", "default": "newsletter",
      "options": [
        { "value": "newsletter", "label": "Newsletter link" },
        { "value": "email", "label": "Email link" },
        { "value": "rss", "label": "RSS feed" },
        { "value": "off", "label": "No button" } ] },
    { "key": "home_layout", "type": "select", "label": "Home layout", "default": "shelf",
      "options": [
        { "value": "shelf", "label": "Shelf grid" },
        { "value": "series", "label": "Rows by topic" },
        { "value": "list", "label": "Compact list" } ] },
    { "key": "inks", "type": "select", "label": "Card colors", "default": "archive",
      "options": [
        { "value": "archive", "label": "Four inks by topic" },
        { "value": "ink", "label": "One dark ink" },
        { "value": "accent", "label": "Button color" } ] },
    { "key": "card_style", "type": "select", "label": "Cards", "default": "ink",
      "options": [
        { "value": "ink", "label": "Covers and ink blocks" },
        { "value": "cover", "label": "Covers only" },
        { "value": "text", "label": "Text only" } ] },
    { "key": "columns", "type": "select", "label": "Columns on wide screens", "default": "3",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" } ] },
    { "key": "tag_bar", "type": "boolean", "label": "Topic bar under the header", "default": true }
  ]
}
