{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "dossier",
  "name": "Dossier",
  "version": "1.0.0",
  "summary": "For consultants and job seekers: a one-page CV with your profile on the side and your work listed by date.",
  "description": "An online CV laid out like a neat fact sheet. Your portrait, role and contact details stay in view on the side while visitors scroll. The headings in your bio become labels such as Now, Previously and Publications, your work is listed by date, and one orange dot marks featured pieces. For consultants, freelancers and job seekers.",
  "categories": ["professionals"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "plex",
      "label": "IBM Plex Sans and Mono",
      "google": "family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;1,400",
      "stacks": {
        "body": "\"IBM Plex Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "display": "\"IBM Plex Sans\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f5f4f0", "text": "#191919", "muted": "#5c5c5c" },
    "dark": { "bg": "#161616", "text": "#e8e6e1", "muted": "#9a9a9a" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "orange", "custom": true,
      "presets": [
        { "value": "orange", "label": "Signal orange", "light": "#b04a12", "dark": "#f08a4b" },
        { "value": "ochre", "label": "Signal yellow", "light": "#8a6400", "dark": "#f5c518" },
        { "value": "green", "label": "Power green", "light": "#2b7a4b", "dark": "#5fc28a" },
        { "value": "blue", "label": "Dial blue", "light": "#1f5f8b", "dark": "#7fb6e0" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "paper", "type": "select", "label": "Paper (light mode)", "default": "paper",
      "options": [
        { "value": "paper", "label": "Warm paper" },
        { "value": "concrete", "label": "Concrete" } ] },
    { "key": "layout", "type": "select", "label": "Layout", "default": "split",
      "options": [
        { "value": "split", "label": "Profile left, CV right" },
        { "value": "split-right", "label": "CV left, profile right" },
        { "value": "single", "label": "One column" } ] },
    { "key": "portrait", "type": "select", "label": "Portrait", "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "mono", "label": "Square, black and white" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "date_format", "type": "select", "label": "Dates in lists", "default": "month",
      "options": [
        { "value": "month", "label": "2026-02" },
        { "value": "year", "label": "2026" },
        { "value": "full", "label": "2026-02-14" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "thumbnails", "type": "select", "label": "Row thumbnails", "default": "featured",
      "options": [
        { "value": "featured", "label": "Featured posts only" },
        { "value": "all", "label": "Every post with a cover" },
        { "value": "none", "label": "None" } ] }
  ]
}
