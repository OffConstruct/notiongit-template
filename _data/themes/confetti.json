{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "confetti",
  "name": "Confetti",
  "version": "1.0.0",
  "summary": "The panel sheet: your work in flat color panels split by ink gutters, your name as a mast.",
  "description": "For illustrators who like color. The home page says your bio out loud, sets your name huge at the foot of the first screen, then lays your posts out as a sheet of saturated panels. Posts without a cover become solid color panels, each post page opens on a band of color, and every artwork sits uncropped inside its field.",
  "categories": ["artists"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page", "tags"],
  "fonts": [
    {
      "value": "bricolage",
      "label": "Bricolage Grotesque",
      "google": "family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800",
      "stacks": {
        "body": "\"Bricolage Grotesque\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
        "display": "\"Bricolage Grotesque\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fff3d6", "text": "#2a1a0e", "muted": "#6b5340" },
    "dark": { "bg": "#1b130c", "text": "#fff3d6", "muted": "#c9b79c" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Cream" },
        { "value": "dark", "label": "Ink" } ] },
    { "key": "accent", "type": "color", "label": "Link color", "role": "text", "default": "tomato", "custom": true,
      "presets": [
        { "value": "tomato", "label": "Tomato", "light": "#c2381f", "dark": "#ff8f6b" },
        { "value": "cobalt", "label": "Cobalt", "light": "#2742c4", "dark": "#9db0ff" },
        { "value": "green", "label": "Green", "light": "#1f6b3a", "dark": "#7fd39a" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "panels", "type": "select", "label": "Panel colors", "default": "sorbet",
      "options": [
        { "value": "sorbet", "label": "Sorbet" },
        { "value": "primary", "label": "Primary" },
        { "value": "earth", "label": "Earth" },
        { "value": "mono", "label": "Paper greys" } ] },
    { "key": "gutter", "type": "select", "label": "Gutters", "default": "ink",
      "options": [
        { "value": "ink", "label": "Ink rules" },
        { "value": "none", "label": "Panels touch" } ] },
    { "key": "shape", "type": "select", "label": "Panel corners", "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "soft", "label": "Soft" },
        { "value": "arch", "label": "Arched tops" } ] },
    { "key": "density", "type": "select", "label": "Sheet density", "default": "roomy",
      "options": [
        { "value": "roomy", "label": "Roomy, four across" },
        { "value": "packed", "label": "Packed, six across" } ] },
    { "key": "avatar", "type": "select", "label": "Portrait", "default": "sticker",
      "options": [
        { "value": "sticker", "label": "Sticker" },
        { "value": "circle", "label": "Circle" },
        { "value": "hidden", "label": "Hidden" } ] }
  ]
}
