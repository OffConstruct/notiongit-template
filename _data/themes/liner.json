{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "liner",
  "name": "Liner",
  "version": "0.1.0",
  "summary": "Liner notes in system type: Now and Dates side by side, then a dated log of everything.",
  "description": "The inside of a record sleeve, set by the browser. Your links lead the header, the home page pairs your current release with a Dates list built from posts tagged live, and every post sits in a plain dated log. For producers, DJs and bands who want the site to read like a tracklist.",
  "categories": ["musicians"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "helvetica",
      "label": "Helvetica",
      "google": null,
      "stacks": {
        "body": "\"Helvetica Neue\", Helvetica, Arial, \"Liberation Sans\", sans-serif",
        "display": "\"Helvetica Neue\", Helvetica, Arial, \"Liberation Sans\", sans-serif",
        "mono": "ui-monospace, Menlo, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
      }
    },
    {
      "value": "times",
      "label": "Times",
      "google": null,
      "stacks": {
        "body": "\"Times New Roman\", Times, \"Liberation Serif\", serif",
        "display": "\"Times New Roman\", Times, \"Liberation Serif\", serif",
        "mono": "ui-monospace, Menlo, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
      }
    },
    {
      "value": "courier",
      "label": "Courier",
      "google": null,
      "stacks": {
        "body": "\"Courier New\", Courier, \"Liberation Mono\", monospace",
        "display": "\"Courier New\", Courier, \"Liberation Mono\", monospace",
        "mono": "\"Courier New\", Courier, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#000000", "muted": "#6b6b6b" },
    "dark": { "bg": "#000000", "text": "#e8e8e8", "muted": "#9a9a9a" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "White" },
        { "value": "dark", "label": "Black" } ] },
    { "key": "accent", "type": "color", "label": "Name color", "role": "text", "default": "ink", "custom": true,
      "presets": [
        { "value": "ink", "label": "Ink", "light": "#000000", "dark": "#e8e8e8" },
        { "value": "green", "label": "Green", "light": "#1d7a00", "dark": "#c6ff00" },
        { "value": "red", "label": "Red", "light": "#c40000", "dark": "#ff6a5c" },
        { "value": "orange", "label": "Orange", "light": "#b34a00", "dark": "#ff9a3c" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "font", "type": "font", "label": "Type", "default": "helvetica" },
    { "key": "home_layout", "type": "select", "label": "Home page", "default": "now",
      "options": [
        { "value": "now", "label": "Now and Dates" },
        { "value": "log", "label": "Log only" },
        { "value": "bio", "label": "Bio only" } ] },
    { "key": "dates", "type": "boolean", "label": "Dates from posts tagged live", "default": true },
    { "key": "date_format", "type": "select", "label": "Dates in the log", "default": "numeric",
      "options": [
        { "value": "numeric", "label": "21.11.2025" },
        { "value": "short", "label": "21 Nov 2025" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "name_size", "type": "select", "label": "Name", "default": "wordmark",
      "options": [
        { "value": "wordmark", "label": "Large wordmark" },
        { "value": "corner", "label": "Small, in the corner" } ] }
  ]
}
