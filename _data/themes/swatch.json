{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "swatch",
  "name": "Swatch",
  "version": "1.0.0",
  "summary": "For brand and type designers: your name in huge type beside a slowly mixing sample of your brand color, then your work.",
  "description": "A black-and-white page on a strict grid. The home page sets your name in very large type next to a small card of your accent color that slowly mixes its own shades, labeled with its color code like a printed sample. Featured posts follow as large numbered rows, then your other posts as dated rows and your links in one line at the bottom. For brand, identity and type designers.",
  "categories": ["designers"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "inter",
      "label": "Inter Tight, Inter and Plex Mono",
      "google": "family=Inter+Tight:wght@500;600&family=Inter:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400",
      "stacks": {
        "body": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Inter Tight\", Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "familjen",
      "label": "Familjen Grotesk and Martian Mono",
      "google": "family=Familjen+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=Martian+Mono:wght@400",
      "stacks": {
        "body": "\"Familjen Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Familjen Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"Martian Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fafaf9", "text": "#0b0b0b", "muted": "#6a6a66" },
    "dark": { "bg": "#0c0c0c", "text": "#f2f2f0", "muted": "#8f8f8a" }
  },
  "motion": {
    "shader": "mesh-gradient",
    "placement": "slot",
    "speed": 0.12,
    "frame": 4200,
    "colors": {
      "colors": ["--sw-chip", "--motion-light", "--sw-chip", "--motion-shade", "--sw-chip"]
    },
    "params": { "distortion": 0.3, "swirl": 0.08, "grainOverlay": 0.1 }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "large", "default": "signal", "custom": true,
      "presets": [
        { "value": "signal", "label": "Signal orange", "light": "#ff4d1f", "dark": "#ff7a52" },
        { "value": "cobalt", "label": "Cobalt blue", "light": "#2b3dff", "dark": "#8592ff" },
        { "value": "pine", "label": "Pine green", "light": "#0b8a52", "dark": "#3fd08a" },
        { "value": "magenta", "label": "Magenta", "light": "#e0197a", "dark": "#ff6aa8" },
        { "value": "ochre", "label": "Ochre", "light": "#b97400", "dark": "#f0b13c" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "inter" },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "name_size", "type": "select", "label": "Name size", "default": "large",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" } ] },
    { "key": "sample", "type": "boolean", "label": "Show the color sample", "default": true },
    { "key": "preview", "type": "boolean", "label": "Cover under the mouse (computers only)", "default": true }
  ]
}
