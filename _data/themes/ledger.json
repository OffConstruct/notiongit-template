{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "ledger",
  "name": "Ledger",
  "version": "1.0.0",
  "summary": "The maker's console: a sticky profile beside a grid of ventures with status chips and a mono-dated writing table.",
  "description": "For indie makers and founders who run several things at once. Dark by default, with hairline panels in the spirit of modern builder tools. Featured posts become venture cells whose first tag is a status chip (live, sold, paused, shut-down), and every post sits in a table with mono dates and tags.",
  "categories": ["entrepreneurs", "developers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "inter",
      "label": "Inter Tight, Inter and JetBrains Mono",
      "google": "family=Inter+Tight:wght@600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500",
      "stacks": {
        "body": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Inter Tight\", Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif",
        "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fbfbfa", "text": "#0b0c0e", "muted": "#5f6570" },
    "dark": { "bg": "#08090a", "text": "#f7f8f8", "muted": "#8a909a" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "dark",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Signal color", "role": "text", "default": "green", "custom": true,
      "presets": [
        { "value": "green", "label": "Signal green", "light": "#136c42", "dark": "#4cc38a" },
        { "value": "amber", "label": "Amber", "light": "#8a5a00", "dark": "#f0b44c" },
        { "value": "cyan", "label": "Cyan", "light": "#0b6680", "dark": "#5fc8e8" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "layout", "type": "select", "label": "Home layout", "default": "sidebar",
      "options": [
        { "value": "sidebar", "label": "Profile sidebar" },
        { "value": "stacked", "label": "Single column, link-in-bio" } ] },
    { "key": "ventures_columns", "type": "range", "label": "Venture columns", "min": 1, "max": 3, "step": 1, "unit": "", "default": 2 },
    { "key": "writing_style", "type": "select", "label": "Writing on the home page", "default": "table",
      "options": [
        { "value": "table", "label": "Table rows" },
        { "value": "cards", "label": "Cards" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "status_chips", "type": "boolean", "label": "Status colors on tags", "default": true },
    { "key": "nav_style", "type": "select", "label": "Navigation", "default": "numbered",
      "options": [
        { "value": "numbered", "label": "Numbered keys" },
        { "value": "slash", "label": "Slash paths" },
        { "value": "plain", "label": "Plain" } ] }
  ]
}
