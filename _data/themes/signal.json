{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "signal",
  "name": "Signal",
  "version": "1.0.0",
  "summary": "For professionals: your name in huge clean letters, colored section bars and posts listed like a timetable.",
  "description": "Clean, confident and orderly. Your name fills the top of the page in large letters, each section opens with a full-width colored bar and a big number, your posts read like a timetable, and your email or CV becomes the one button. For freelancers and consultants who sell a service.",
  "categories": ["professionals"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "archivo",
      "label": "Archivo",
      "google": "family=Archivo:wdth,wght@62..125,400..500",
      "stacks": {
        "body": "Archivo, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "display": "Archivo, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#000000", "muted": "#6b6b6b" },
    "dark": { "bg": "#000000", "text": "#ffffff", "muted": "#9a9a9a" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "surface", "default": "red", "custom": false,
      "presets": [
        { "value": "red", "label": "Red", "light": "#c8102e", "dark": "#c8102e", "on": "#ffffff" },
        { "value": "blue", "label": "Blue", "light": "#0033a0", "dark": "#0033a0", "on": "#ffffff" },
        { "value": "green", "label": "Green", "light": "#00754a", "dark": "#00754a", "on": "#ffffff" },
        { "value": "yellow", "label": "Yellow", "light": "#f5c518", "dark": "#f5c518", "on": "#000000" },
        { "value": "orange", "label": "Orange", "light": "#ff6f00", "dark": "#ff6f00", "on": "#000000" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "nameplate", "type": "select", "label": "Name size", "default": "huge",
      "options": [
        { "value": "huge", "label": "Huge, full width" },
        { "value": "large", "label": "Large" },
        { "value": "modest", "label": "Modest" } ] },
    { "key": "name_width", "type": "select", "label": "Name width", "default": "condensed",
      "options": [
        { "value": "condensed", "label": "Narrow" },
        { "value": "normal", "label": "Normal" } ] },
    { "key": "bars", "type": "select", "label": "Section bars", "default": "accent",
      "options": [
        { "value": "accent", "label": "Signal color" },
        { "value": "ink", "label": "Black (white in dark mode)" },
        { "value": "rules", "label": "Rules only" } ] },
    { "key": "grid_lines", "type": "boolean", "label": "Show the column grid", "default": false },
    { "key": "cta", "type": "select", "label": "Button", "default": "contact",
      "options": [
        { "value": "contact", "label": "First email or PDF link" },
        { "value": "nav", "label": "Last menu item" },
        { "value": "none", "label": "No button" } ] }
  ]
}
