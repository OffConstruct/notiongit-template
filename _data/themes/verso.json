{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "verso",
  "name": "Verso",
  "version": "1.0.0",
  "summary": "For photographers and artists: a short text beside one large photo, plus a list of your work.",
  "description": "Like the left-hand page of a photobook. Your name, menu and a line of bio stay on one side, one large photo faces them, shown whole, and every project is listed by title and year. Pointing at a title shows its photo. For fine-art and documentary photographers.",
  "categories": ["photographers", "artists"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "garamond",
      "label": "EB Garamond",
      "google": "family=EB+Garamond:ital,wght@0,400;0,500;1,400",
      "stacks": {
        "body": "\"EB Garamond\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
        "display": "\"EB Garamond\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "piazzolla",
      "label": "Piazzolla",
      "google": "family=Piazzolla:ital,opsz,wght@0,8..30,400;0,8..30,500;1,8..30,400",
      "stacks": {
        "body": "Piazzolla, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
        "display": "Piazzolla, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "newsreader",
      "label": "Newsreader",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400",
      "stacks": {
        "body": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#e9eded", "text": "#1b1d1d", "muted": "#5c6262" },
    "dark": { "bg": "#141515", "text": "#e3e5e2", "muted": "#9aa09e" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "ink", "custom": false,
      "presets": [
        { "value": "ink", "label": "Ink only", "light": "#1b1d1d", "dark": "#e3e5e2" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "garamond" },
    { "key": "ground", "type": "select", "label": "Background", "default": "mount",
      "options": [
        { "value": "mount", "label": "Soft gray" },
        { "value": "paper", "label": "Warm paper" },
        { "value": "white", "label": "Gallery white" } ] },
    { "key": "column", "type": "select", "label": "Text column", "default": "left",
      "options": [
        { "value": "left", "label": "Fixed on the left" },
        { "value": "top", "label": "One line at the top" } ] },
    { "key": "home", "type": "select", "label": "Home page", "default": "spread",
      "options": [
        { "value": "spread", "label": "Big photo and list" },
        { "value": "index", "label": "List only" },
        { "value": "plate", "label": "Big photo only" } ] },
    { "key": "dates", "type": "select", "label": "Dates", "default": "year",
      "options": [
        { "value": "year", "label": "Year only" },
        { "value": "full", "label": "Full date" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "plate_swap", "type": "boolean", "label": "Show a post's cover when you point at it", "default": true }
  ]
}
