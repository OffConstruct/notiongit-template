{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "lumen",
  "name": "Lumen",
  "version": "1.0.0",
  "summary": "For photographers who work with natural light: whole photos in two staggered columns, with faint daylight moving behind.",
  "description": "For photographers who work with natural light. The home page shows your name, a row of topics, then your latest projects like plates in a book: each photo whole, in two staggered columns, captioned with title, topic and year. Faint daylight drifts slowly across the margins behind them. Your bio, email and links close the page.",
  "categories": ["photographers"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "schibsted",
      "label": "Schibsted Grotesk",
      "google": "family=Schibsted+Grotesk:wght@400;500&family=Geist+Mono:wght@400",
      "stacks": {
        "body": "\"Schibsted Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Schibsted Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "inter",
      "label": "Inter Tight",
      "google": "family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400",
      "stacks": {
        "body": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Inter Tight\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f2efe9", "text": "#1c1b19", "muted": "#6a665e" },
    "dark": { "bg": "#141413", "text": "#ece8e0", "muted": "#9b968c" }
  },
  "motion": {
    "shader": "god-rays",
    "placement": "backdrop",
    "speed": 0.12,
    "frame": 6000,
    "colors": {
      "colorBack": "--ink-bg",
      "colorBloom": "--motion-light",
      "colors": ["--motion-light", "--motion-ray"]
    },
    "params": {
      "intensity": 0.12,
      "density": 0.22,
      "spotty": 0.2,
      "midIntensity": 0.12,
      "midSize": 0.3,
      "bloom": 0.25,
      "offsetX": "--motion-x",
      "offsetY": -0.9,
      "scale": 1.4
    }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "terracotta", "custom": true,
      "presets": [
        { "value": "terracotta", "label": "Terracotta", "light": "#a4552a", "dark": "#e08a5a" },
        { "value": "sage", "label": "Sage", "light": "#566f53", "dark": "#9cbf96" },
        { "value": "ink", "label": "No accent (text color)", "light": "#1c1b19", "dark": "#ece8e0" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "schibsted" },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "light", "type": "select", "label": "Daylight comes from", "default": "left",
      "options": [
        { "value": "left", "label": "Top left" },
        { "value": "right", "label": "Top right" } ] },
    { "key": "layout", "type": "select", "label": "Photo columns", "default": "staggered",
      "options": [
        { "value": "staggered", "label": "Two staggered columns" },
        { "value": "level", "label": "Two even columns" },
        { "value": "single", "label": "One wide column" } ] },
    { "key": "captions", "type": "select", "label": "Photo captions", "default": "full",
      "options": [
        { "value": "full", "label": "Title, topic and year" },
        { "value": "title", "label": "Title only" } ] }
  ]
}
