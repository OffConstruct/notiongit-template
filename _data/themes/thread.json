{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "thread",
  "name": "Thread",
  "version": "1.0.0",
  "summary": "For writers who return to the same topics: the home page sorts your posts by tag into ruled columns.",
  "description": "A quiet home for essayists and note-takers who write about a few topics again and again. A slim strip at the top carries your name over fine threads that drift slowly. Below it, your most used tags become columns, each with its newest titles and a link to the rest. Posts without a tag gather under Loose ends, and your latest posts follow, listed by year.",
  "categories": ["writers"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page", "tags"],
  "fonts": [
    {
      "value": "schibsted",
      "label": "Schibsted Grotesk and Alegreya",
      "google": "family=Alegreya:ital,wght@0,400;0,500;1,400&family=Schibsted+Grotesk:wght@400;500;600",
      "stacks": {
        "body": "Alegreya, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "\"Schibsted Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f5f6f3", "text": "#1c1f22", "muted": "#5f6569" },
    "dark": { "bg": "#121514", "text": "#e1e5e1", "muted": "#939a96" }
  },
  "motion": {
    "shader": "neuro-noise",
    "placement": "slot",
    "speed": 0.12,
    "frame": 6000,
    "colors": { "colorBack": "--ink-bg", "colorMid": "--motion-tint", "colorFront": "--motion-tint-2" },
    "params": { "brightness": 0.06, "contrast": 0.2, "scale": 0.3 }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "moss", "custom": true,
      "presets": [
        { "value": "moss", "label": "Moss", "light": "#2f5d50", "dark": "#86b8a6" },
        { "value": "slate", "label": "Slate blue", "light": "#36507a", "dark": "#9db5dc" },
        { "value": "rust", "label": "Rust", "light": "#8a4630", "dark": "#e0a088" },
        { "value": "plum", "label": "Plum", "light": "#664475", "dark": "#c9a8d8" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "topics", "type": "select", "label": "Topics on the home page", "default": "three",
      "options": [
        { "value": "three", "label": "Top 3 tags" },
        { "value": "six", "label": "Top 6 tags" } ] },
    { "key": "per_topic", "type": "select", "label": "Titles under each topic", "default": "three",
      "options": [
        { "value": "three", "label": "3 newest" },
        { "value": "five", "label": "5 newest" } ] },
    { "key": "strip", "type": "select", "label": "Top strip shows on", "default": "all",
      "options": [
        { "value": "all", "label": "Every page" },
        { "value": "home", "label": "Home page only" } ] }
  ]
}
