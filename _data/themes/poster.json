{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "poster",
  "name": "Poster",
  "version": "1.0.0",
  "summary": "Color fields: a huge name, then one flat color band per featured work.",
  "description": "Every section is a flat color field with one thing set huge in it. The name fills the first band in Bricolage Grotesque, each featured post gets its own band with its cover, or with its title at poster size when it has none, and the rest are numbered notes. For brand designers, illustrators and letterers whose work is the hero.",
  "categories": ["designers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page", "tags"],
  "fonts": [
    {
      "value": "bricolage",
      "label": "Bricolage Grotesque and Public Sans",
      "google": "family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Public+Sans:ital,wght@0,400;0,600;1,400",
      "stacks": {
        "body": "\"Public Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Bricolage Grotesque\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#d3ceba", "text": "#45260e", "muted": "#5b3a20" },
    "dark": { "bg": "#1d1712", "text": "#e9e1cc", "muted": "#bfb39c" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Name color", "role": "large", "default": "signal", "custom": true,
      "presets": [
        { "value": "signal", "label": "Signal red", "light": "#c92e17", "dark": "#ff7a5c" },
        { "value": "cobalt", "label": "Cobalt", "light": "#1f3bff", "dark": "#8c9bff" },
        { "value": "ink", "label": "Same as text", "light": "#45260e", "dark": "#e9e1cc" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "fields", "type": "select", "label": "Band colors", "default": "earth",
      "options": [
        { "value": "earth", "label": "Earth: sage, brown, olive" },
        { "value": "cobalt", "label": "Cobalt: blue, lilac, navy" },
        { "value": "blush", "label": "Blush: pink, maroon, cyan" } ] },
    { "key": "display_width", "type": "select", "label": "Display width", "default": "regular",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "condensed", "label": "Condensed" } ] },
    { "key": "name_size", "type": "select", "label": "Name size", "default": "huge",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "huge", "label": "Huge" } ] },
    { "key": "work_layout", "type": "select", "label": "Featured work", "default": "bands",
      "options": [
        { "value": "bands", "label": "One band each" },
        { "value": "pairs", "label": "Two to a row" } ] },
    { "key": "notes_numbered", "type": "boolean", "label": "Number the notes", "default": true },
    { "key": "portrait", "type": "boolean", "label": "Show portrait", "default": true }
  ]
}
