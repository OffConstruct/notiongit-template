{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "workbench",
  "name": "Workbench",
  "version": "1.0.0",
  "summary": "For developers: your profile beside a featured post, post cards, and every topic with its count.",
  "description": "A tidy home for people with a lot to show. Your profile sits beside one featured post, recent posts follow as cards or as table rows, and a topic list shows every topic with how many posts it has. For developers and technical writers.",
  "categories": ["developers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "instrument",
      "label": "Instrument Sans and IBM Plex Mono",
      "google": "family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500",
      "stacks": {
        "body": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Instrument Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "system",
      "label": "System fonts (no downloads)",
      "google": null,
      "stacks": {
        "body": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#15181c", "muted": "#5b626b" },
    "dark": { "bg": "#0e1113", "text": "#e7eaec", "muted": "#9aa3ab" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "emerald", "custom": true,
      "presets": [
        { "value": "emerald", "label": "Emerald", "light": "#007a5a", "dark": "#3ddc97" },
        { "value": "cobalt", "label": "Cobalt", "light": "#1d4ed8", "dark": "#8fb0ff" },
        { "value": "orange", "label": "Signal orange", "light": "#b4440e", "dark": "#ff9a5c" },
        { "value": "slate", "label": "Slate", "light": "#3d4a5c", "dark": "#b6c2d1" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "instrument" },
    { "key": "home_layout", "type": "select", "label": "Home layout", "default": "split",
      "options": [
        { "value": "split", "label": "Profile beside the featured post" },
        { "value": "stacked", "label": "Profile above the featured post" } ] },
    { "key": "list_style", "type": "select", "label": "Post list", "default": "cards",
      "options": [
        { "value": "cards", "label": "Cards" },
        { "value": "rows", "label": "Table rows" } ] },
    { "key": "tag_index", "type": "boolean", "label": "Show the topic index", "default": true },
    { "key": "word_count", "type": "boolean", "label": "Show word counts", "default": true }
  ]
}
