{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "hush",
  "name": "Hush",
  "version": "0.1.0",
  "summary": "For ambient, piano and quiet composers: your newest piece inside a slowly breathing ring of smoke.",
  "description": "A calm page for ambient, neoclassical and solo piano composers and sound artists. The home page opens on one soft ring of smoke that breathes like a held note, with the title of your newest piece resting in its still center. Below it come your bio and a quiet list of your other works, each with its year and a short description. It needs no photos.",
  "categories": ["musicians"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "hanken",
      "label": "Light and plain",
      "google": "family=Hanken+Grotesk:wght@300;400;500&family=IBM+Plex+Mono:wght@400",
      "stacks": {
        "body": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "instrument",
      "label": "Serif titles",
      "google": "family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500&family=IBM+Plex+Mono:wght@400",
      "stacks": {
        "body": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Instrument Serif\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f2f1ee", "text": "#1c1c1f", "muted": "#67656b" },
    "dark": { "bg": "#121316", "text": "#e6e5e1", "muted": "#8f8d93" }
  },
  "motion": {
    "shader": "smoke-ring",
    "placement": "slot",
    "speed": 0.08,
    "frame": 3200,
    "colors": { "colorBack": "--ink-bg", "colors": ["--motion-tint"] },
    "params": { "radius": 0.44, "thickness": 0.2, "innerShape": 0.8, "noiseScale": 1.4, "noiseIterations": 4, "scale": 0.86 }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "large", "default": "slate", "custom": true,
      "presets": [
        { "value": "slate", "label": "Slate", "light": "#6f7f96", "dark": "#9fb0c9" },
        { "value": "rose", "label": "Dusk rose", "light": "#9a6b78", "dark": "#d3a6b3" },
        { "value": "moss", "label": "Moss", "light": "#6d8669", "dark": "#a5bf9f" },
        { "value": "amber", "label": "Amber", "light": "#97733f", "dark": "#d6b27c" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "hanken" },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "ring", "type": "select", "label": "Ring size", "default": "large",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "small", "label": "Small" } ] },
    { "key": "list_heading", "type": "select", "label": "Heading above your posts", "default": "works",
      "options": [
        { "value": "works", "label": "Works" },
        { "value": "releases", "label": "Releases" },
        { "value": "journal", "label": "Journal" } ] },
    { "key": "excerpts", "type": "boolean", "label": "Short description under each title", "default": true }
  ]
}
