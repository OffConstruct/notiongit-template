{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "vitrine",
  "name": "Vitrine",
  "version": "1.0.0",
  "summary": "For artists: one artwork at a time on a white wall, each with a printed label beside it.",
  "description": "One artwork at a time, as on a gallery wall. The home page opens on your newest work, uncropped, with your name and bio beside it like a wall label. Other works hang one per row with printed captions, and every post is listed in a numbered index by year. No decoration: the art brings the color. For artists.",
  "categories": ["artists"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page", "tags"],
  "fonts": [
    {
      "value": "newsreader",
      "label": "Newsreader",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500",
      "stacks": {
        "body": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "garamond",
      "label": "EB Garamond",
      "google": "family=EB+Garamond:ital,wght@0,400;0,500;1,400",
      "stacks": {
        "body": "\"EB Garamond\", Garamond, \"Iowan Old Style\", Georgia, serif",
        "display": "\"EB Garamond\", Garamond, \"Iowan Old Style\", Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "caslon",
      "label": "Libre Caslon",
      "google": "family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400",
      "stacks": {
        "body": "\"Libre Caslon Text\", \"Big Caslon\", \"Iowan Old Style\", Georgia, serif",
        "display": "\"Libre Caslon Text\", \"Big Caslon\", \"Iowan Old Style\", Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fdfdfb", "text": "#141414", "muted": "#5f5f5c" },
    "dark": { "bg": "#161615", "text": "#ebe8e2", "muted": "#9b978f" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Link color", "role": "text", "default": "ink", "custom": true,
      "presets": [
        { "value": "ink", "label": "Ink only", "light": "#141414", "dark": "#ebe8e2" },
        { "value": "oxide", "label": "Oxide red", "light": "#a3321f", "dark": "#e8907a" },
        { "value": "ultramarine", "label": "Ultramarine", "light": "#2b3a9e", "dark": "#a3aef0" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "newsreader" },
    { "key": "hang", "type": "select", "label": "Layout of works", "default": "offset",
      "options": [
        { "value": "offset", "label": "Alternating left and right" },
        { "value": "centered", "label": "One centered column" },
        { "value": "pairs", "label": "Two per row" } ] },
    { "key": "caption", "type": "select", "label": "Captions", "default": "beside",
      "options": [
        { "value": "beside", "label": "Beside the work" },
        { "value": "below", "label": "Below the work" } ] },
    { "key": "wall", "type": "select", "label": "Wall color (light mode)", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "warm", "label": "Warm white" },
        { "value": "grey", "label": "Gallery gray" } ] },
    { "key": "index_numbers", "type": "boolean", "label": "Number the list of works", "default": true }
  ]
}
