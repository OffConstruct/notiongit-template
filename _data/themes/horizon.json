{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "horizon",
  "name": "Horizon",
  "version": "0.1.0",
  "summary": "For a small business or solo practice with one offer: your tagline, a slow band of color and a Get in touch button.",
  "description": "A quiet page for a yoga teacher, therapist, coach or local studio who wants visitors to get in touch. The home page shows your tagline in large type, a slow band of color that drifts like light on water, and one button to email you. Below it are your bio as a short list of how you work, your featured and latest posts, and your contact details again.",
  "categories": ["marketing"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "instrument",
      "label": "Tall, narrow serif",
      "google": "family=Instrument+Serif&family=Onest:wght@400;500;600",
      "stacks": {
        "body": "Onest, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Instrument Serif\", \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "newsreader",
      "label": "Classic book serif",
      "google": "family=Newsreader:opsz,wght@6..72,300..500&family=Onest:wght@400;500;600",
      "stacks": {
        "body": "Onest, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f6f4ef", "text": "#1b2430", "muted": "#5b6470" },
    "dark": { "bg": "#10161c", "text": "#e8ece9", "muted": "#9aa6ad" }
  },
  "motion": {
    "shader": "simplex-noise",
    "placement": "slot",
    "speed": 0.2,
    "frame": 3000,
    "colors": { "colors": ["--ink-bg", "--motion-sand", "--motion-sea", "--ink-bg"] },
    "params": { "stepsPerColor": 2, "softness": 0.95, "scale": 0.4, "rotation": 0 }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "harbor", "custom": true,
      "presets": [
        { "value": "harbor", "label": "Harbor blue", "light": "#2f6f8f", "dark": "#7fb3c8" },
        { "value": "kelp", "label": "Kelp green", "light": "#4a6b3f", "dark": "#9cc08c" },
        { "value": "sunset", "label": "Sunset", "light": "#a3523a", "dark": "#e3a186" },
        { "value": "dusk", "label": "Dusk", "light": "#62568a", "dark": "#b4a8d8" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "instrument" },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "band", "type": "select", "label": "Band of color", "default": "tall",
      "options": [
        { "value": "tall", "label": "Tall" },
        { "value": "slim", "label": "Slim" } ] },
    { "key": "button", "type": "select", "label": "Button text", "default": "touch",
      "options": [
        { "value": "touch", "label": "Get in touch" },
        { "value": "book", "label": "Book a session" },
        { "value": "hello", "label": "Say hello" } ] },
    { "key": "bio_heading", "type": "select", "label": "Heading above your bio", "default": "work",
      "options": [
        { "value": "work", "label": "How I work" },
        { "value": "about", "label": "About" },
        { "value": "offer", "label": "What I offer" } ] }
  ]
}
