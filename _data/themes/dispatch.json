{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "dispatch",
  "name": "Dispatch",
  "version": "1.0.0",
  "summary": "For newsletter writers: one centered headline, a subscribe button and your letters listed by year.",
  "description": "A home page written like a short letter. Your tagline is the headline, one button sends readers to your newsletter, your bio reads as the letter itself, then a short Start here list of featured posts and a quiet list of everything by year. For newsletter writers.",
  "categories": ["marketing", "writers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post"],
  "fonts": [
    {
      "value": "newsreader",
      "label": "Newsreader and Geist Mono",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Geist+Mono:wght@400;500",
      "stacks": {
        "body": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#121316", "muted": "#55585f" },
    "dark": { "bg": "#181818", "text": "#ecebe8", "muted": "#a3a3a3" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Button and link color", "role": "text", "default": "vermilion", "custom": true,
      "presets": [
        { "value": "vermilion", "label": "Vermilion", "light": "#c2410c", "dark": "#ff7a45" },
        { "value": "blue", "label": "Ink blue", "light": "#1d4ed8", "dark": "#8aa8ff" },
        { "value": "forest", "label": "Forest", "light": "#2f6648", "dark": "#7cc79a" },
        { "value": "plum", "label": "Plum", "light": "#7a2e5c", "dark": "#e59ac6" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "cta", "type": "select", "label": "Main button", "default": "newsletter",
      "options": [
        { "value": "newsletter", "label": "Newsletter link" },
        { "value": "email", "label": "Email link" },
        { "value": "rss", "label": "RSS feed" },
        { "value": "off", "label": "No button" } ] },
    { "key": "home_layout", "type": "select", "label": "Home layout", "default": "letter",
      "options": [
        { "value": "letter", "label": "Centered letter" },
        { "value": "split", "label": "Split with color panel" } ] },
    { "key": "list_style", "type": "select", "label": "Post list", "default": "years",
      "options": [
        { "value": "years", "label": "Titles by year" },
        { "value": "excerpts", "label": "Titles with excerpts" } ] },
    { "key": "read_time", "type": "boolean", "label": "Show reading time", "default": true },
    { "key": "measure", "type": "range", "label": "Text width", "min": 34, "max": 44, "step": 2, "unit": "rem", "default": 38 }
  ]
}
