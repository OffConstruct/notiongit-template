{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "megaphone",
  "name": "Megaphone",
  "version": "1.0.0",
  "summary": "For marketers and creators: your tagline as a giant headline on warm black, with one bright button under it.",
  "description": "Built around one loud sentence. Your tagline fills the first screen in tall capitals with one bright button under it. Numbered sections follow for About, Featured and Latest, then a bold quote from your bio. Dark by default, with a cream light mode. For creators and personal brands.",
  "categories": ["marketing", "entrepreneurs"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post"],
  "fonts": [
    {
      "value": "archivo",
      "label": "Archivo",
      "google": "family=Archivo:ital,wdth,wght@0,62..125,400..700;1,100,400",
      "stacks": {
        "body": "Archivo, \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif",
        "display": "Archivo, \"Arial Narrow\", \"Roboto Condensed\", \"Helvetica Neue\", system-ui, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f2eee3", "text": "#131209", "muted": "#57534a" },
    "dark": { "bg": "#131209", "text": "#f2eee3", "muted": "#a39e8e" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "dark",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "surface", "default": "chartreuse", "custom": false,
      "presets": [
        { "value": "chartreuse", "label": "Chartreuse", "light": "#d4f53c", "dark": "#d4f53c", "on": "#131209" },
        { "value": "orange", "label": "Signal orange", "light": "#ff6b2c", "dark": "#ff6b2c", "on": "#131209" },
        { "value": "pink", "label": "Hot pink", "light": "#ff4fa3", "dark": "#ff4fa3", "on": "#131209" },
        { "value": "cyan", "label": "Cyan", "light": "#3ce0e8", "dark": "#3ce0e8", "on": "#131209" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "cta", "type": "select", "label": "Main button", "default": "newsletter",
      "options": [
        { "value": "newsletter", "label": "Newsletter link" },
        { "value": "email", "label": "Email link" },
        { "value": "rss", "label": "RSS feed" },
        { "value": "off", "label": "No button" } ] },
    { "key": "hero_size", "type": "select", "label": "Headline size", "default": "full",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "compact", "label": "Compact" } ] },
    { "key": "marquee", "type": "select", "label": "Scrolling text strip", "default": "off",
      "options": [
        { "value": "off", "label": "Off" },
        { "value": "tags", "label": "Your tags" },
        { "value": "name", "label": "Your name" } ] },
    { "key": "numbered", "type": "boolean", "label": "Numbered sections", "default": true },
    { "key": "avatar", "type": "select", "label": "Profile picture", "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "circle", "label": "Circle" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "statement", "type": "boolean", "label": "Show the statement section", "default": true }
  ]
}
