{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "contour",
  "name": "Contour",
  "version": "0.1.0",
  "summary": "For field and earth scientists: a slowly drifting map beside your bio and your writing, grouped by year.",
  "description": "A calm two-column site for ecologists, geologists, climate and ocean researchers and graduate students who do fieldwork. On the home page, a small framed map of contour lines drifts slowly next to your name, bio and links. Your writing sits beside it, grouped by year, with dates and tags. It needs no photos.",
  "categories": ["researchers"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "newsreader",
      "label": "Newsreader and Plex",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@400",
      "stacks": {
        "body": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f4f1e8", "text": "#1d211c", "muted": "#5d6358" },
    "dark": { "bg": "#121612", "text": "#e4e6dc", "muted": "#9aa293" }
  },
  "motion": {
    "shader": "simplex-noise",
    "placement": "slot",
    "speed": 0.08,
    "frame": 6000,
    "colors": {
      "colors": ["--contour-3", "--contour-2", "--contour-1", "--ink-bg", "--contour-1", "--contour-2", "--contour-3"]
    },
    "params": { "stepsPerColor": 3, "softness": 0.1, "scale": "--contour-scale" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "moss", "custom": true,
      "presets": [
        { "value": "moss", "label": "Moss", "light": "#3f6a4a", "dark": "#8fbf98" },
        { "value": "ocean", "label": "Ocean", "light": "#2f5f78", "dark": "#8db8d0" },
        { "value": "clay", "label": "Clay", "light": "#8a4a30", "dark": "#dba183" },
        { "value": "ochre", "label": "Ochre", "light": "#6f5a1c", "dark": "#cdb36c" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "map", "type": "select", "label": "Shape of the map on wide screens", "default": "square",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "tall", "label": "Tall" },
        { "value": "wide", "label": "Wide" } ] },
    { "key": "detail", "type": "select", "label": "Contour lines", "default": "fine",
      "options": [
        { "value": "fine", "label": "Close together" },
        { "value": "broad", "label": "Far apart" } ] },
    { "key": "tags", "type": "boolean", "label": "Show tags under each title", "default": true },
    { "key": "elsewhere", "type": "boolean", "label": "List your other pages under your writing", "default": true }
  ]
}
