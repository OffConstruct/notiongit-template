{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "logbook",
  "name": "Logbook",
  "version": "1.0.0",
  "summary": "For founders who post short updates: every post on a dated timeline, newest first, beside a short Now note.",
  "description": "An updates log for founders and small teams. The home page shows your name and tagline over a thin strip of slowly moving dots, then every post on a timeline with its date and first tag, and a Now note taken from the first paragraph of your bio. Featured posts get a filled dot and their summary. Works well with many short posts and no photos.",
  "categories": ["entrepreneurs"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "plex",
      "label": "IBM Plex",
      "google": "family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500",
      "stacks": {
        "body": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fafaf8", "text": "#121212", "muted": "#6a6a66" },
    "dark": { "bg": "#0f0f0e", "text": "#ececea", "muted": "#8f8f8a" }
  },
  "motion": {
    "shader": "dithering",
    "placement": "slot",
    "speed": 0.15,
    "frame": 1200,
    "colors": { "colorBack": "--motion-base", "colorFront": "--motion-tint" },
    "params": { "shape": "simplex", "type": "4x4", "size": 2, "scale": 0.22 }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "large", "default": "signal", "custom": true,
      "presets": [
        { "value": "signal", "label": "Signal orange", "light": "#e8501a", "dark": "#ff7a45" },
        { "value": "cobalt", "label": "Cobalt", "light": "#2f5bd8", "dark": "#7f9cff" },
        { "value": "green", "label": "Green", "light": "#1d8048", "dark": "#4cc282" },
        { "value": "graphite", "label": "Graphite", "light": "#121212", "dark": "#ececea" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "strip", "type": "select", "label": "Dotted strip shows on", "default": "all",
      "options": [
        { "value": "all", "label": "Every page" },
        { "value": "home", "label": "Home page only" } ] },
    { "key": "dates", "type": "select", "label": "Date style", "default": "numeric",
      "options": [
        { "value": "numeric", "label": "2026.03.01" },
        { "value": "written", "label": "Mar 1, 2026" } ] },
    { "key": "summaries", "type": "select", "label": "Post summaries on the timeline", "default": "featured",
      "options": [
        { "value": "featured", "label": "Featured posts only" },
        { "value": "all", "label": "Every post" },
        { "value": "none", "label": "None" } ] },
    { "key": "now_note", "type": "boolean", "label": "Show your bio on the home page", "default": true }
  ]
}
