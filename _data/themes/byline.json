{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "byline",
  "name": "Byline",
  "version": "1.0.1",
  "summary": "For journalists and writers: a newspaper-style front page with your lead story, bio and stories grouped by topic.",
  "description": "A newspaper front page and clip file. Your name sits between double lines like a masthead, your latest featured story leads beside an About the author box, and each topic becomes its own section of headlines. Stories you published elsewhere name the outlet and link to it. For journalists, critics and columnists.",
  "categories": ["writers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "sourceserif",
      "label": "Source Serif 4 and Libre Franklin",
      "google": "family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Libre+Franklin:wght@500;600;700",
      "stacks": {
        "body": "\"Source Serif 4\", \"Source Serif Pro\", Charter, \"Iowan Old Style\", Georgia, serif",
        "display": "\"Source Serif 4\", \"Source Serif Pro\", Charter, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#ffffff", "text": "#121212", "muted": "#5f5f5f" },
    "dark": { "bg": "#111111", "text": "#e9e7e2", "muted": "#9c9a95" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Label color", "role": "text", "default": "red", "custom": true,
      "presets": [
        { "value": "red", "label": "Press red", "light": "#b3122a", "dark": "#ff6b6b" },
        { "value": "navy", "label": "Navy", "light": "#1f3a5f", "dark": "#8fb3e0" },
        { "value": "green", "label": "Green", "light": "#1e6b52", "dark": "#6fcfaa" },
        { "value": "black", "label": "Black", "light": "#121212", "dark": "#e9e7e2" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "paper", "type": "select", "label": "Paper", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "newsprint", "label": "Newsprint" } ] },
    { "key": "front", "type": "select", "label": "Front page", "default": "lead",
      "options": [
        { "value": "lead", "label": "Lead story and About" },
        { "value": "presskit", "label": "Press kit (bio first)" },
        { "value": "sections", "label": "Sections only" } ] },
    { "key": "group_by", "type": "select", "label": "Group stories by", "default": "tag",
      "options": [
        { "value": "tag", "label": "Tag sections" },
        { "value": "date", "label": "One latest list" } ] },
    { "key": "kicker", "type": "select", "label": "Label above headlines", "default": "tag",
      "options": [
        { "value": "tag", "label": "First tag" },
        { "value": "date", "label": "Month and year" },
        { "value": "outlet", "label": "Outlet" } ] },
    { "key": "columns", "type": "select", "label": "Section columns", "default": "two",
      "options": [
        { "value": "two", "label": "Two" },
        { "value": "one", "label": "One" } ] },
    { "key": "thumbnails", "type": "boolean", "label": "Show thumbnails", "default": false }
  ]
}
