{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "margin",
  "name": "Margin",
  "version": "1.0.0",
  "summary": "The quiet column: one 600px measure, two type sizes and a single link color.",
  "description": "A letter-like home in one narrow column: name and tagline, the bio as prose, then Selected work, Writing and Elsewhere as plain sections. Posts are unruled title and date rows; long reads are set in Newsreader. For product and design engineers whose taste shows in measure and rhythm.",
  "categories": ["designers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page", "tags"],
  "fonts": [
    {
      "value": "newsreader",
      "label": "Newsreader and Inter",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500",
      "stacks": {
        "body": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f6f5f1", "text": "#1f1e1b", "muted": "#66645e" },
    "dark": { "bg": "#151514", "text": "#e8e6e1", "muted": "#a19e96" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Link color", "role": "text", "default": "sea", "custom": true,
      "presets": [
        { "value": "sea", "label": "Sea", "light": "#00758f", "dark": "#6cc3d3" },
        { "value": "moss", "label": "Moss", "light": "#2f6a3b", "dark": "#8fcf98" },
        { "value": "rust", "label": "Rust", "light": "#b23a1e", "dark": "#f0957a" },
        { "value": "graphite", "label": "Graphite", "light": "#1f1e1b", "dark": "#e8e6e1" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "reading_font", "type": "select", "label": "Post body face", "default": "serif",
      "options": [
        { "value": "serif", "label": "Newsreader (serif)" },
        { "value": "sans", "label": "Inter (sans)" } ] },
    { "key": "measure", "type": "range", "label": "Column width", "min": 560, "max": 720, "step": 40, "unit": "px", "default": 600 },
    { "key": "date_style", "type": "select", "label": "Dates in lists", "default": "year",
      "options": [
        { "value": "year", "label": "Year, once per group" },
        { "value": "month", "label": "Month and year" },
        { "value": "full", "label": "Full date" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "home_order", "type": "select", "label": "Home sections", "default": "selected",
      "options": [
        { "value": "selected", "label": "Selected, then Writing" },
        { "value": "writing", "label": "Writing, then Selected" },
        { "value": "writing-only", "label": "Writing only" } ] },
    { "key": "avatar", "type": "select", "label": "Portrait", "default": "circle",
      "options": [
        { "value": "circle", "label": "Circle" },
        { "value": "square", "label": "Square" },
        { "value": "hidden", "label": "Hidden" } ] }
  ]
}
