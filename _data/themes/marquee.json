{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "marquee",
  "name": "Marquee",
  "version": "1.0.0",
  "summary": "For founders building in public: your name poster-size, a highlighted tagline and bold cards for featured work.",
  "description": "For makers, coaches and small businesses that want to be noticed. Your name is set poster-size, your tagline sits under a highlighter stripe, featured posts become bold two-color cards, and a band near the end invites readers to follow along.",
  "categories": ["entrepreneurs", "marketing"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "bricolage",
      "label": "Bricolage Grotesque",
      "google": "family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800",
      "stacks": {
        "body": "\"Bricolage Grotesque\", \"Avenir Next\", Avenir, \"Segoe UI\", system-ui, sans-serif",
        "display": "\"Bricolage Grotesque\", \"Avenir Next Condensed\", \"Arial Narrow\", \"Segoe UI\", system-ui, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fbf6e6", "text": "#1c1917", "muted": "#6e675b" },
    "dark": { "bg": "#14120f", "text": "#f3eddc", "muted": "#a8a08f" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Highlight color", "role": "surface", "default": "acid", "custom": false,
      "presets": [
        { "value": "acid", "label": "Acid", "light": "#d7f25b", "dark": "#d7f25b", "on": "#1c1917" },
        { "value": "coral", "label": "Coral", "light": "#ff8a65", "dark": "#ff8a65", "on": "#1c1917" },
        { "value": "sky", "label": "Sky", "light": "#9ad7ff", "dark": "#9ad7ff", "on": "#1c1917" },
        { "value": "butter", "label": "Butter", "light": "#f9df65", "dark": "#f9df65", "on": "#1c1917" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "ground", "type": "select", "label": "Paper", "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "paper", "label": "White" } ] },
    { "key": "hero_style", "type": "select", "label": "Top of the home page", "default": "name",
      "options": [
        { "value": "name", "label": "Name huge" },
        { "value": "statement", "label": "Tagline huge, name above it" },
        { "value": "portrait", "label": "Large portrait beside the name" } ] },
    { "key": "card_tones", "type": "select", "label": "Featured cards", "default": "alternate",
      "options": [
        { "value": "alternate", "label": "Mixed: black, indigo, highlight" },
        { "value": "ink", "label": "All black" },
        { "value": "accent", "label": "All highlight" } ] },
    { "key": "subscribe_band", "type": "boolean", "label": "Show the follow section", "default": true },
    { "key": "show_excerpts", "type": "boolean", "label": "Excerpts in post lists", "default": true }
  ]
}
