{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "skylight",
  "name": "Skylight",
  "version": "1.0.0",
  "summary": "For architects and landscape designers: your name in large type beside a tall window of light, then your projects.",
  "description": "For architects, landscape designers and anyone who photographs spaces. The home page opens with your name in very large, light type beside a tall, narrow window where faint daylight drifts in. Your featured projects follow as a two-column picture index with a short caption under each, then a list of your writing by year and a studio section with your bio and links.",
  "categories": ["professionals"],
  "audience": [],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "geist",
      "label": "Geist",
      "google": "family=Geist:wght@300;400;500&family=Geist+Mono:wght@400",
      "stacks": {
        "body": "Geist, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "Geist, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    },
    {
      "value": "hanken",
      "label": "Hanken Grotesk",
      "google": "family=Hanken+Grotesk:wght@300;400;500&family=IBM+Plex+Mono:wght@400",
      "stacks": {
        "body": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "display": "\"Hanken Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
        "mono": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#eeece6", "text": "#1c1c1a", "muted": "#62615b" },
    "dark": { "bg": "#121312", "text": "#e9e7e1", "muted": "#9a9890" }
  },
  "motion": {
    "shader": "god-rays",
    "placement": "slot",
    "speed": 0.08,
    "frame": 6000,
    "colors": {
      "colorBack": "--sl-pane",
      "colorBloom": "--sl-pane",
      "colors": ["--motion-ray"]
    },
    "params": {
      "intensity": "--motion-intensity",
      "density": 0.2,
      "spotty": 0.15,
      "midIntensity": 0.2,
      "midSize": 0.15,
      "bloom": 0.3,
      "offsetX": "--motion-x",
      "offsetY": -1,
      "fit": "cover"
    }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "lamp", "custom": true,
      "presets": [
        { "value": "lamp", "label": "Lamp amber", "light": "#8a5a12", "dark": "#d9a556" },
        { "value": "sky", "label": "North sky", "light": "#3d5f7c", "dark": "#9ebbd3" },
        { "value": "clay", "label": "Fired clay", "light": "#9a4a2c", "dark": "#e0997b" },
        { "value": "moss", "label": "Moss", "light": "#4b6640", "dark": "#a5c08f" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "geist" },
    { "key": "motion", "type": "select", "label": "Motion", "default": "on",
      "options": [
        { "value": "on", "label": "Moving" },
        { "value": "still", "label": "Still" },
        { "value": "off", "label": "Off" } ] },
    { "key": "light", "type": "select", "label": "Daylight comes from", "default": "right",
      "options": [
        { "value": "right", "label": "Top right" },
        { "value": "left", "label": "Top left" } ] },
    { "key": "name_case", "type": "select", "label": "Name on the home page", "default": "written",
      "options": [
        { "value": "written", "label": "As written" },
        { "value": "lower", "label": "All lowercase" } ] },
    { "key": "gallery", "type": "select", "label": "Project pictures", "default": "staggered",
      "options": [
        { "value": "staggered", "label": "Staggered heights" },
        { "value": "even", "label": "Even grid" } ] }
  ]
}
