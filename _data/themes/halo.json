{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "halo",
  "name": "Halo",
  "version": "0.1.0",
  "summary": "For bands and DJs: a concert poster with your name in giant letters, your latest releases and upcoming dates.",
  "description": "A dark concert poster. Your name sits across the top in wide capitals, your newest release stands on bands of color, then your upcoming dates, a row of releases and your links set large. Every cover is shown in black and one bright color, so any artwork fits. Tag a post live to list it under Dates. For bands, DJs and electronic producers.",
  "categories": ["musicians"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "archivo",
      "label": "Archivo",
      "google": "family=Archivo:wdth,wght@62..125,100..900",
      "stacks": {
        "body": "Archivo, \"Helvetica Neue\", Arial, sans-serif",
        "display": "Archivo, \"Arial Black\", \"Helvetica Neue\", Arial, sans-serif",
        "mono": "ui-monospace, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#eee2c5", "text": "#0a0608", "muted": "#5e5547" },
    "dark": { "bg": "#0a0608", "text": "#eee2c5", "muted": "#a39a88" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "dark",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent color", "role": "text", "default": "red", "custom": true,
      "presets": [
        { "value": "red", "label": "Red", "light": "#b30006", "dark": "#ff4a3d" },
        { "value": "ultraviolet", "label": "Ultraviolet", "light": "#5b2bff", "dark": "#a78bff" },
        { "value": "acid", "label": "Acid", "light": "#3d6600", "dark": "#b6ff00" },
        { "value": "amber", "label": "Amber", "light": "#8a5300", "dark": "#ffb000" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "image", "type": "select", "label": "Covers", "default": "duotone",
      "options": [
        { "value": "duotone", "label": "Two-tone" },
        { "value": "mono", "label": "Black and white" },
        { "value": "original", "label": "Original color" } ] },
    { "key": "horizon", "type": "boolean", "label": "Horizon stripes", "default": true },
    { "key": "name_style", "type": "select", "label": "Name", "default": "center",
      "options": [
        { "value": "center", "label": "Giant, centered" },
        { "value": "left", "label": "Giant, left" },
        { "value": "outline", "label": "Outlined" } ] },
    { "key": "hero", "type": "select", "label": "Poster image", "default": "cover",
      "options": [
        { "value": "cover", "label": "Newest release" },
        { "value": "portrait", "label": "Profile picture" },
        { "value": "none", "label": "Name only" } ] },
    { "key": "releases", "type": "select", "label": "Releases", "default": "strip",
      "options": [
        { "value": "strip", "label": "Scrolling strip" },
        { "value": "grid", "label": "Grid" } ] }
  ]
}
