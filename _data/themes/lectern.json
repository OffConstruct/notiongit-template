{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "lectern",
  "name": "Lectern",
  "version": "1.0.0",
  "summary": "The syllabus: a course handout in Alegreya with a margin-dated index and sidenotes.",
  "description": "One calm column set like a well-made course handout: name, italic tagline and bio, a reading-by-topic line built from your tags, then a writing index with dates in the margin. Posts read like lecture notes, with footnotes beside the text on wide screens. For teachers, lecturers and tutors.",
  "categories": ["educators", "researchers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "alegreya",
      "label": "Alegreya",
      "google": "family=Alegreya:ital,wght@0,400;0,500;0,700;1,400&family=Alegreya+Sans+SC:wght@500&family=Source+Code+Pro:wght@400;600",
      "stacks": {
        "body": "Alegreya, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "\"Alegreya Sans SC\", \"Gill Sans\", \"Trebuchet MS\", system-ui, sans-serif",
        "mono": "\"Source Code Pro\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#fbf8f1", "text": "#1f1c17", "muted": "#6b645a" },
    "dark": { "bg": "#16130f", "text": "#ece6da", "muted": "#a59d90" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Paper" },
        { "value": "dark", "label": "Night" } ] },
    { "key": "accent", "type": "color", "label": "Ink color", "role": "text", "default": "oxblood", "custom": true,
      "presets": [
        { "value": "oxblood", "label": "Oxblood", "light": "#8a2b2b", "dark": "#e08a7f" },
        { "value": "navy", "label": "Navy", "light": "#24406b", "dark": "#9db7e0" },
        { "value": "forest", "label": "Forest", "light": "#2f5a3a", "dark": "#8fc49c" },
        { "value": "ink", "label": "Black ink only", "light": "#1f1c17", "dark": "#ece6da" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "grouping", "type": "select", "label": "Group the writing index", "default": "year",
      "options": [
        { "value": "year", "label": "By year" },
        { "value": "tag", "label": "By topic" },
        { "value": "flat", "label": "One list" } ] },
    { "key": "show_dates", "type": "boolean", "label": "Show dates in the margin", "default": true },
    { "key": "reading_router", "type": "boolean", "label": "Show reading by topic", "default": true },
    { "key": "sidenotes", "type": "boolean", "label": "Footnotes beside the text", "default": true },
    { "key": "drop_cap", "type": "boolean", "label": "Drop cap on posts", "default": false }
  ]
}
