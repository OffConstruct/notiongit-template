{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "quire",
  "name": "Quire",
  "version": "1.1.1",
  "summary": "The book: front matter, a preface and a contents page in EB Garamond.",
  "description": "Home set like a book's front matter: half-title, preface, then a countdown-numbered contents list with dotted leaders. Featured posts with covers become a one-per-row shelf, and posts open like chapters with a drop cap.",
  "categories": ["writers"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "garamond",
      "label": "EB Garamond",
      "google": "family=EB+Garamond:ital,wght@0,400;0,600;1,400",
      "stacks": {
        "body": "\"EB Garamond\", Garamond, \"Iowan Old Style\", Georgia, serif",
        "display": "\"EB Garamond\", Garamond, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f1ecde", "text": "#1a1a18", "muted": "#6b6553" },
    "dark": { "bg": "#1a1916", "text": "#eae3d2", "muted": "#a39b86" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Accent", "role": "text", "default": "sienna", "custom": true,
      "presets": [
        { "value": "sienna", "label": "Sienna", "light": "#9a4426", "dark": "#e0946f" },
        { "value": "teal", "label": "Teal", "light": "#1b4b5a", "dark": "#7fc4d3" },
        { "value": "oxblood", "label": "Oxblood", "light": "#7e2a26", "dark": "#e48a80" },
        { "value": "ink", "label": "Ink only", "light": "#1a1a18", "dark": "#eae3d2" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Load web fonts", "default": true },
    { "key": "paper", "type": "select", "label": "Paper", "default": "bone",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "white", "label": "White" } ] },
    { "key": "numbering", "type": "select", "label": "Contents numbering", "default": "countdown",
      "options": [
        { "value": "countdown", "label": "Countdown" },
        { "value": "roman", "label": "Roman" },
        { "value": "none", "label": "None" } ] },
    { "key": "show_dates", "type": "select", "label": "Dates in contents", "default": "year",
      "options": [
        { "value": "year", "label": "Year" },
        { "value": "full", "label": "Full date" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "books_shelf", "type": "boolean", "label": "Show featured covers as books", "default": true },
    { "key": "drop_cap", "type": "boolean", "label": "Drop cap", "default": true },
    { "key": "measure", "type": "range", "label": "Line length", "min": 30, "max": 38, "step": 2, "unit": "em", "default": 34 }
  ]
}
