{
  "$schema": "../../scripts/themes/theme.schema.json",
  "schema_version": 1,
  "id": "letterhead",
  "name": "Letterhead",
  "version": "1.0.0",
  "summary": "For lawyers, doctors and consultants: formal letter paper, a short introduction and a numbered contents list.",
  "description": "A quiet, formal site that feels like printed letter paper. Your name heads the page, your bio reads as an introduction, and your pages and featured writing form a numbered contents list. One elegant typeface and one amber line. For lawyers, doctors and senior advisers.",
  "categories": ["professionals"],
  "author": { "name": "InkDrafts", "url": "https://inkdrafts.com" },
  "license": "MIT",
  "slots": ["header", "footer", "home", "blog", "post", "page"],
  "fonts": [
    {
      "value": "newsreader",
      "label": "Newsreader",
      "google": "family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400",
      "stacks": {
        "body": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "display": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    },
    {
      "value": "garamond",
      "label": "EB Garamond",
      "google": "family=EB+Garamond:ital,wght@0,400;1,400",
      "stacks": {
        "body": "\"EB Garamond\", Garamond, \"Iowan Old Style\", Georgia, serif",
        "display": "\"EB Garamond\", Garamond, \"Iowan Old Style\", Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    },
    {
      "value": "literata",
      "label": "Literata",
      "google": "family=Literata:ital,opsz,wght@0,7..72,400;1,7..72,400",
      "stacks": {
        "body": "Literata, \"Iowan Old Style\", Georgia, serif",
        "display": "Literata, \"Iowan Old Style\", Georgia, serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      }
    }
  ],
  "palette": {
    "light": { "bg": "#f0ede4", "text": "#1b1b1b", "muted": "#5a6352" },
    "dark": { "bg": "#1c1b18", "text": "#e8e4d9", "muted": "#a9b29e" }
  },
  "tweaks": [
    { "key": "mode", "type": "select", "label": "Color scheme", "default": "auto",
      "options": [
        { "value": "auto", "label": "Match system" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" } ] },
    { "key": "accent", "type": "color", "label": "Link and line color", "role": "text", "default": "amber", "custom": true,
      "presets": [
        { "value": "amber", "label": "Amber", "light": "#7a4623", "dark": "#c98a5c" },
        { "value": "oxblood", "label": "Oxblood", "light": "#7a1f2b", "dark": "#d9868e" },
        { "value": "forest", "label": "Forest", "light": "#2f4f3a", "dark": "#93bb9f" },
        { "value": "ink", "label": "Black only", "light": "#1b1b1b", "dark": "#e8e4d9" } ] },
    { "key": "webfonts", "type": "boolean", "label": "Use the design's own fonts", "default": true },
    { "key": "font", "type": "font", "label": "Fonts", "default": "newsreader" },
    { "key": "ground", "type": "select", "label": "Paper (light mode)", "default": "chamois",
      "options": [
        { "value": "chamois", "label": "Chamois" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" } ] },
    { "key": "letterhead_align", "type": "select", "label": "Top of the page", "default": "left",
      "options": [
        { "value": "left", "label": "Name left, menu right" },
        { "value": "centered", "label": "Centered" } ] },
    { "key": "portrait", "type": "select", "label": "Portrait", "default": "margin",
      "options": [
        { "value": "margin", "label": "In the margin" },
        { "value": "hidden", "label": "Hidden" } ] },
    { "key": "index_marker", "type": "select", "label": "Contents list shows", "default": "numbered",
      "options": [
        { "value": "numbered", "label": "Numbers and years" },
        { "value": "year", "label": "Years only" },
        { "value": "none", "label": "Titles only" } ] },
    { "key": "justify", "type": "boolean", "label": "Justified text", "default": false }
  ]
}
